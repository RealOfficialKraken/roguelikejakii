(in-package goal)

;; name: bbush-random.gc

(deftype bbush-random (process)
    ((checkpoint            string)
    (general-i                 int)
    (bbush-1                symbol)
    (bbush-2                symbol)
    (bbush-3                symbol)
    (bbush-4                symbol)
    (bbush-5                symbol)
    (bbush-6                symbol)
    (bbush-7                symbol)
    (bbush-8                symbol)
    (bbush-9                symbol)
    )
    (:state-methods
    init-self
    active
    dormant
    get-random-bbush
    )
    (:methods
    (check-for-complete (_type_) none)
    (bbush-random-event-handler (_type_ process int symbol event-message-block) object)
    (general-event-handler (_type_ process int symbol event-message-block) object)
    )
)

(defun reset-acts! ()
    (set! act1-1 #f)
    (set! act1-2 #f)
    (set! act1-3 #f)
    (set! act2-1 #f)
    (set! act2-2 #f)
    (set! act2-3 #f)
    (set! act3-1 #f)
    (set! act3-2 #f)
    (set! act3-3 #f)
    (none)
)

(defbehavior bbush-random-event-handler bbush-random ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (general-event-handler self arg0 arg1 arg2 arg3)
  )

(defbehavior bbush-random-init-by-other bbush-random ()
    (set! (-> self checkpoint) "")
    (set! (-> self general-i) 0)
    (set! (-> self bbush-1) #f)
    (set! (-> self bbush-2) #f)
    (set! (-> self bbush-3) #f)
    (set! (-> self bbush-4) #f)
    (set! (-> self bbush-5) #f)
    (set! (-> self bbush-6) #f)
    (set! (-> self bbush-7) #f)
    (set! (-> self bbush-8) #f)
    (set! (-> self bbush-9) #f)
    (go-virtual init-self)
    (none)
)

(defun spawn-bbushrandom ()
    (set! *bbush-random*
        (process-spawn bbush-random :name "bbush-random")
    )
    (none)
)

(defstate init-self (bbush-random)
    :virtual #t
    :event bbush-random-event-handler
    :code (behavior()
        (loop
            (if (or
                    (= act1-1 #t)
                    (= act2-1 #t)
                    (= act3-1 #t)
                    (= act4-1 #t)
                )
                (go-virtual active)
                (go-virtual dormant)
            )
            (when *debug-segment*
                (format *stdcon* "bbush-random INIT-SELF")
            )
            (suspend)
        )
    )
)

(defstate dormant (bbush-random)
    :virtual #t
    :event bbush-random-event-handler
    :code (behavior()
        (loop
            (when *debug-segment*
                (format *stdcon* "bbush-random DORMANT")
            )
            (suspend)
        )
    )
)

(defstate active (bbush-random)
    :virtual #t
    :event bbush-random-event-handler
    :code (behavior()
        (loop
            (when (= in-game? #f)
                (go-virtual dormant)
            )
            (when *debug-segment*
                (format *stdcon* "bbush-random ACTIVE")
            )
            (suspend)
        )
    )
)

(defmethod general-event-handler ((this bbush-random) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
    (case arg2
        (('init-bbush!)
            (set! roll-shopitems #t)
            (set! wait-for-ingame #t)
            (set! (-> *game-info* gem) temp-skullgemamount)
            (set! (-> *target* fact health) temp-health)
            (set! (-> *game-info* skill) temp-orbs)
            (go (method-of-object this get-random-bbush))
        )
        (('reset!)
            (set! (-> this general-i) 0)
            (set! (-> this bbush-1) #f)
            (set! (-> this bbush-2) #f)
            (set! (-> this bbush-3) #f)
            (set! (-> this bbush-4) #f)
            (set! (-> this bbush-5) #f)
            (set! (-> this bbush-6) #f)
            (set! (-> this bbush-7) #f)
            (set! (-> this bbush-8) #f)
            (set! (-> this bbush-9) #f)
            (go (method-of-object this dormant))
        )
    )
)

(defstate get-random-bbush (bbush-random)
    :virtual #t
    :code (behavior()
        (loop
            (let
                (
                    (rnd 0)
                )
                (set! rnd (rand-vu-int-range 1 9))
                (set! waitenter #t)
                (when (and (not (-> self bbush-1)) (= rnd 1))
                    (dm-play-task-with-continue (game-task city-burning-bush-ring-1) "ctyslumb-burning-bush")
                    (set! (-> self bbush-1) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-2)) (= rnd 2))
                    (dm-play-task-with-continue (game-task city-burning-bush-collection-1) "ctygenb-burning-bush")
                    (set! (-> self bbush-2) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-3)) (= rnd 3))
                    (dm-play-task-with-continue (game-task city-burning-bush-racepoint-1) "ctymarka-burning-bush")
                    (set! (-> self bbush-3) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-4)) (= rnd 4))
                    (dm-play-task-with-continue (game-task city-burning-bush-ring-2) "ctyport-burning-bush")
                    (set! (-> self bbush-4) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-5)) (= rnd 5))
                    (dm-play-task-with-continue (game-task city-burning-bush-shuttle-1) "ctymarka-burning-bush")
                    (set! (-> self bbush-5) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-6)) (= rnd 6))
                    (dm-play-task-with-continue (game-task city-burning-bush-collection-2) "ctygenc-burning-bush")
                    (set! (-> self bbush-6) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-7)) (= rnd 7))
                    (dm-play-task-with-continue (game-task city-burning-bush-ring-3) "ctyslumb-burning-bush")
                    (set! (-> self bbush-7) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-8)) (= rnd 8))
                    (dm-play-task-with-continue (game-task city-burning-bush-bombbot-1) "ctymarka-burning-bush")
                    (set! (-> self bbush-8) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
                (when (and (not (-> self bbush-9)) (= rnd 9))
                    (dm-play-task-with-continue (game-task city-burning-bush-collection-3) "ctyfarma-burning-bush")
                    (set! (-> self bbush-9) #t)
                    (reset-acts!)
                    (go-virtual dormant)
                )
            )
            (suspend)
        )
    )
)

(defun send-bbush! ()
    (send-event (ppointer->process *bbush-random*) 'init-bbush! #t)
    (none)
)

(defun init-bbush! ()
    (set! *bbush-random*
        (process-spawn bbush-random :name "bbush-random")
    )
    (none)
)